# Copy to .env and adjust. All variables are optional.

MP_ENVIRONMENT=development
MP_LOG_LEVEL=INFO
MP_LOG_JSON=true

# Data provider: csv (bundled synthetic data) or binance (public REST API)
MP_DATA_PROVIDER=csv
# MP_DATA_DIR=./data
# MP_BINANCE_BASE_URL=https://api.binance.com
# MP_BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# MP_PROVIDER_TIMEOUT_SECONDS=10

# Cache: memory or redis
MP_CACHE_BACKEND=memory
# MP_REDIS_URL=redis://localhost:6379/0
MP_CACHE_TTL_SECONDS=30
# MP_CACHE_MAX_ENTRIES=1024

# Comma-separated API keys. Empty = authentication disabled.
MP_API_KEYS=

MP_RATE_LIMIT_ENABLED=true
MP_RATE_LIMIT_PER_MINUTE=120
MP_RATE_LIMIT_BURST=30

MP_ALERT_EVAL_ENABLED=true
MP_ALERT_EVAL_INTERVAL_SECONDS=15
# MP_ALERT_LOOKBACK=300

# MP_DEFAULT_LIMIT=200
# MP_MAX_LIMIT=1000
